digraph PermissionFlow {
  rankdir=TB;
  bgcolor="white";
  node [shape=box, style="filled", fillcolor="white", color="#888888", fontname="Helvetica", fontcolor="black", fontsize=10, margin="0.15,0.1"];
  edge [color="#555555", fontname="Helvetica", fontsize=9, fontcolor="black"];

  start [label="currentPosition() called"];
  serviceCheck [label="Is location switched on\nfor the device?"];
  msg1 [label="LocationException:\n'Location is switched off\non this device.'", fillcolor="#fdece5", color="#8f4b39"];
  permCheck [label="checkPermission()"];
  request [label="requestPermission()\n(one system dialog)"];
  msg2 [label="LocationException:\n'Location permission\nwas denied.'", fillcolor="#fdece5", color="#8f4b39"];
  foreverCheck [label="Is permission\ndeniedForever?"];
  msg3 [label="LocationException:\n'Permission is permanently\ndenied. Allow it in Settings.'", fillcolor="#fdece5", color="#8f4b39"];
  getPos [label="getCurrentPosition()\n(forceLocationManager: true)"];
  timeout [label="Timeout after 15s"];
  lastKnown [label="getLastKnownPosition()"];
  success [label="Position returned to caller"];

  start -> serviceCheck;
  serviceCheck -> msg1 [label="off"];
  serviceCheck -> permCheck [label="on"];
  permCheck -> request [label="denied"];
  request -> msg2 [label="still denied"];
  request -> foreverCheck [label="granted or\ndeniedForever"];
  permCheck -> foreverCheck [label="already granted\nor deniedForever"];
  foreverCheck -> msg3 [label="yes"];
  foreverCheck -> getPos [label="no (granted)"];
  getPos -> success [label="fix obtained"];
  getPos -> timeout;
  timeout -> lastKnown -> success;
}
