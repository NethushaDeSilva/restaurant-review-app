digraph Navigation {
  rankdir=TB;
  bgcolor="white";
  node [shape=box, style="filled", fillcolor="white", color="#888888", fontname="Helvetica", fontcolor="black", fontsize=11, margin="0.15,0.1"];
  edge [color="#555555", fontname="Helvetica", fontsize=9, fontcolor="black"];

  login [label="Login"];
  register [label="Register"];
  main [label="Main shell\n(NavigationBar / NavigationRail)", fillcolor="#fdece5", color="#8f4b39"];
  home [label="Home"];
  restaurants [label="Restaurants"];
  myreviews [label="My Reviews"];
  profile [label="Profile"];
  detail [label="Restaurant Detail"];
  addreview [label="Add / Edit Review"];
  myrestaurants [label="My Restaurants"];
  addrestaurant [label="Add / Edit Restaurant"];

  login -> register [label="Register link"];
  register -> login [label="back"];
  login -> main [label="sign in succeeds"];
  main -> home; main -> restaurants; main -> myreviews; main -> profile;
  restaurants -> detail [label="tap card"];
  home -> detail [label="tap card"];
  detail -> addreview [label="Write a review"];
  myreviews -> addreview [label="edit"];
  profile -> myrestaurants;
  myrestaurants -> addrestaurant [label="add / edit"];
  myrestaurants -> detail [label="view"];
}
